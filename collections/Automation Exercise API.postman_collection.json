    {
      "name": "API14: GET - User detail by email param",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const schemaUserDetail = {\r",
              "    \"type\": \"object\",\r",
              "    \"required\": [\"responseCode\", \"user\"],\r",
              "    \"properties\": {\r",
              "        \"responseCode\": {\"type\": \"number\"},\r",
              "        \"user\": {\r",
              "            \"type\": \"object\",\r",
              "            \"required\": [\"id\", \"name\", \"email\", \"title\",\r",
              "            \"birth_day\", \"birth_month\", \"birth_year\", \"first_name\", \r",
              "            \"last_name\", \"company\",\"address1\", \"address2\", \"country\", \r",
              "            \"state\", \"city\", \"zipcode\"],\r",
              "            \"properties\": {\r",
              "                \"id\": {\"type\": \"number\"},\r",
              "                \"name\": {\"type\": \"string\"},\r",
              "                \"email\": {\"type\": \"string\"},\r",
              "                \"title\": {\"type\": \"string\"},\r",
              "                \"birth_day\": {\"type\": \"string\"},\r",
              "                \"birth_month\": {\"type\": \"string\"},\r",
              "                \"birth_year\": {\"type\": \"string\"},\r",
              "                \"first_name\": {\"type\": \"string\"},\r",
              "                \"last_name\": {\"type\": \"string\"},\r",
              "                \"company\": {\"type\": \"string\"},\r",
              "                \"address1\": {\"type\": \"string\"},\r",
              "                \"address2\": {\"type\": \"string\"},\r",
              "                \"country\": {\"type\": \"string\"},\r",
              "                \"state\": {\"type\": \"string\"},\r",
              "                \"city\": {\"type\": \"string\"},\r",
              "                \"zipcode\": {\"type\": \"string\"}\r",
              "            }\r",
              "        }\r",
              "    }\r",
              "}\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
