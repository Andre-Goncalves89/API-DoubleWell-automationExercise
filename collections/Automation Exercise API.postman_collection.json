  "item": [
    {
      "name": "API01: GET - All products List",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const schemaProduts = {\r",
              "    \"type\" : \"object\",\r",
              "    \"required\" : [\"responseCode\", \"products\"],\r",
              "    \"properties\" : {\r",
              "        \"responseCode\" : {\"type\" : \"number\"},\r",
              "        \"products\":{\r",
              "            \"type\": \"array\",\r",
              "            \"items\": {\r",
              "                \"type\": \"object\",\r",
              "                \"required\": [\"id\", \"name\", \"price\", \"brand\", \"category\"],\r",
              "                \"properties\": {\r",
              "                    \"id\": {\"type\": \"number\"},\r",
              "                    \"name\": {\"type\": \"string\"},\r",
              "                    \"price\": {\"type\": \"string\"},\r",
              "                    \"brand\": {\"type\": \"string\"},\r",
              "                    \"category\": {\r",
              "                        \"type\": \"object\",\r",
              "                        \"required\": [\"usertype\"],\r",
              "                        \"properties\": {\r",
              "                            \"usertype\": {\r",
              "                                \"type\": \"object\",\r",
              "                                \"required\": [\"usertype\"],\r",
              "                                \"properties\": {\r",
              "                                    \"usertype\": {\"type\": \"string\"}\r",
              "                                }\r",
              "                            }\r",
              "                        }\r",
              "                    }\r",
              "                } \r",
              "            }\r",
              "        }\r",
              "    }\r",
              "}\r",
              "\r",
              "pm.test(\"Validação de Contrato - Schema dos Produtos\", function () {\r",
              "    const resposta = pm.response.json();\r",
              "    const validacao = tv4.validateResult(resposta, schemaProduts)\r",
              "\r",
              "    if(!validacao.valid) {\r",
              "        console.log(\"Erro de schema\", validacao.error)\r",
              "    }\r",
              "\r",
              "    pm.expect(validacao.valid).to.be.true;\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}productsList",
          "host": [
            "{{baseUrl}}productsList"
          ]
        }
      },
      "response": []
    },
    {
      "name": "API05: POST - Search Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const schemaSearchProduct = {\r",
              "    \"type\": \"object\",\r",
              "    \"required\": [\"responseCode\", \"products\"],\r",
              "    \"properties\": {\r",
              "        \"responseCode\": {\"type\": \"number\"},\r",
              "        \"products\": {\r",
              "            \"type\": \"array\",\r",
              "            \"items\": {\r",
              "                \"type\": \"object\",\r",
              "                \"required\": [\"id\", \"name\", \"price\", \"brand\", \"category\" ],\r",
              "                \"properties\": {\r",
              "                    \"id\": {\"type\": \"number\"},\r",
              "                    \"name\": {\"type\": \"string\"},\r",
              "                    \"price\": {\"type\": \"string\"},\r",
              "                    \"btand\": {\"type\": \"string\"},\r",
              "                    \"category\": {\r",
              "                        \"type\": \"object\",\r",
              "                        \"required\": [\"usertype\"],\r",
              "                        \"properties\": {\r",
              "                            \"usertype\": {\r",
              "                                \"type\": \"object\",\r",
              "                                \"required\": [\"usertype\"],\r",
              "                                \"properties\": {\r",
              "                                    \"usertype\" : {\"type\": \"string\"}\r",
              "                                }\r",
              "                            }\r",
              "                        }\r",
              "                    }\r",
              "                }\r",
              "            }\r",
              "        }\r",
              "    }\r",
              "}\r",
              "\r",
              "pm.test(\"Validação de contrato - Schema de busca de produtos \", function () {\r",
              "    const resposta = pm.response.json();\r",
              "    const validacao = tv4.validateResult(resposta, schemaSearchProduct)\r",
              "\r",
              "    if(!validacao.valid){\r",
              "        console.log(\"erro de Schema na busca\", valid.error)\r",
              "    }\r",
              "\r",
              "    pm.expect(validacao.valid).to.be.true;\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
